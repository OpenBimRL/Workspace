load("@rules_kotlin//kotlin:core.bzl", "define_kt_toolchain")

package(default_visibility = ["//visibility:public"])

# Satisfies try-imported OpenBimRL-Engine/.bazelrc --extra_toolchains=//:kotlin_toolchain
define_kt_toolchain(
    name = "kotlin_toolchain",
    api_version = "2.1",
    jvm_target = "17",
    language_version = "2.1",
)

alias(
    name = "help",
    actual = "@openbimrl_engine//:help",
)

alias(
    name = "engine",
    actual = "@openbimrl_engine//:engine_lib",
)

alias(
    name = "webapp_dev",
    actual = "//OpenBimRL-CreatorTool/webapp:dev",
)

alias(
    name = "webapp_build",
    actual = "//OpenBimRL-CreatorTool/webapp:build",
)

alias(
    name = "webapp_build_run",
    actual = "//OpenBimRL-CreatorTool/webapp:build_run",
)

alias(
    name = "rest",
    actual = "@openbimrl_engine_rest//:rest_app",
)

alias(
    name = "rest_deploy.jar",
    actual = "@openbimrl_engine_rest//:rest_deploy.jar",
)

# Engine tests — use test_suite (alias does not work with `bazel test`).
test_suite(
    name = "engine_tests",
    tests = ["@openbimrl_engine//:engine_tests"],
)

test_suite(
    name = "engine_jni_smoke_test",
    tests = ["@openbimrl_engine//:engine_jni_smoke_test"],
)

test_suite(
    name = "pathfinding_minimal_ifc_test",
    tests = ["@openbimrl_engine//:pathfinding_minimal_ifc_test"],
)

test_suite(
    name = "pathfinding_movement_cost_test",
    tests = ["@openbimrl_engine//:pathfinding_movement_cost_test"],
)

test_suite(
    name = "show_distances_test",
    tests = ["@openbimrl_engine//:show_distances_test"],
)
